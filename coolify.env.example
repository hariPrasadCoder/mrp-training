# Paste these variables into Coolify and replace every placeholder.
# Keep this file free of real secrets. The local coolify.env file is ignored by Git.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-a-new-random-secret-with-at-least-32-characters
ADMIN_EMAILS=coach@example.com
LEARNER_EMAILS=learner@example.com
